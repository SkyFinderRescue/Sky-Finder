<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>CA Glider Rescue Mode</title>
  <style>
    :root{
      --bg:#08111f;
      --card:rgba(10,18,31,.82);
      --line:rgba(255,255,255,.12);
      --text:#f5f7fb;
      --muted:#c4d0e6;
      --accent:#ff5a36;
      --ok:#18b56b;
    }
    *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
    html,body{margin:0;padding:0;background:var(--bg);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}
    body{height:100vh;overflow:hidden}
    .frame{
      position:fixed; inset:0;
      width:100%; height:100%;
      border:0; background:#000;
    }
    .topbar{
      position:fixed;
      top: max(10px, env(safe-area-inset-top));
      left:10px; right:10px;
      display:flex; gap:10px; align-items:stretch;
      z-index:10;
      pointer-events:none;
    }
    .panel{
      pointer-events:auto;
      background:var(--card);
      color:var(--text);
      border:1px solid var(--line);
      border-radius:18px;
      padding:12px 14px;
      backdrop-filter: blur(10px);
      box-shadow:0 10px 28px rgba(0,0,0,.35);
    }
    .panel.main{flex:1; min-width:0}
    .title{font-size:18px; font-weight:800; line-height:1.1}
    .sub{margin-top:4px; color:var(--muted); font-size:12px; line-height:1.35}
    .actions{
      display:flex; gap:10px; margin-top:10px; flex-wrap:wrap;
    }
    button,a.btn{
      appearance:none; border:0; text-decoration:none;
      min-height:46px; padding:12px 14px;
      border-radius:14px; cursor:pointer;
      background:var(--accent); color:#fff;
      font-size:16px; font-weight:800;
      display:inline-flex; align-items:center; justify-content:center;
    }
    button.secondary,a.btn.secondary{
      background:rgba(255,255,255,.08);
      border:1px solid var(--line);
      color:var(--text);
    }
    .status{
      display:flex; align-items:center; gap:8px;
      color:var(--muted); font-size:12px; margin-top:8px;
    }
    .dot{
      width:10px; height:10px; border-radius:50%;
      background:#999;
      flex:0 0 auto;
    }
    .dot.ok{background:var(--ok)}
    .dot.warn{background:var(--accent)}
    .bottomhint{
      position:fixed;
      left:10px; right:10px;
      bottom:max(10px, env(safe-area-inset-bottom));
      z-index:10;
      pointer-events:none;
      display:flex; justify-content:center;
    }
    .hint{
      max-width:720px;
      pointer-events:auto;
      background:var(--card);
      color:var(--text);
      border:1px solid var(--line);
      border-radius:18px;
      padding:12px 14px;
      backdrop-filter: blur(10px);
      box-shadow:0 10px 28px rgba(0,0,0,.35);
      font-size:13px; line-height:1.4;
    }
    .pill{
      display:inline-block;
      margin-top:8px;
      padding:6px 10px;
      border-radius:999px;
      background:rgba(255,255,255,.08);
      border:1px solid var(--line);
      font-size:12px;
      color:var(--muted);
    }
    @media (max-width:700px){
      .title{font-size:17px}
      button,a.btn{flex:1}
      .actions{display:grid; grid-template-columns:1fr 1fr}
    }
  </style>
</head>
<body>
  <iframe id="xcframe" class="frame" src="https://xcfind.paraglide.us/map.html?id=16" title="XCFind California"></iframe>

  <div class="topbar">
    <div class="panel main">
      <div class="title">Sky Finder</div>
      <div class="sub"></div>

      <div class="actions">
        <button id="gpsBtn">Use My GPS</button>
        <button id="reloadBtn" class="secondary">Reload Map</button>
        <a class="btn secondary" href="https://xcfind.paraglide.us/map.html?id=16" target="_blank" rel="noopener noreferrer">Open Full XCFind</a>
      </div>

      <div class="status">
        <span id="gpsDot" class="dot warn"></span>
        <span id="gpsText">GPS not started</span>
      </div>
    </div>
  </div>

  <div class="bottomhint">
    <div class="hint">
      <b>Use:</b> tap <b>Use My GPS</b>, then work directly from the live California map.
      Tap a pilot name to open details and recent text/track info inside XCFind.
      
    </div>
  </div>

  <script>
    const gpsBtn = document.getElementById('gpsBtn');
    const reloadBtn = document.getElementById('reloadBtn');
    const xcframe = document.getElementById('xcframe');
    const gpsText = document.getElementById('gpsText');
    const gpsDot = document.getElementById('gpsDot');

    let watchId = null;
    let lastPos = null;

    function setGpsStatus(text, kind='warn'){
      gpsText.textContent = text;
      gpsDot.className = 'dot ' + (kind === 'ok' ? 'ok' : 'warn');
    }

    function startGps(){
      if(!navigator.geolocation){
        setGpsStatus('Geolocation not supported on this device');
        return;
      }
      setGpsStatus('Requesting GPS…');
      if(watchId !== null) navigator.geolocation.clearWatch(watchId);
      watchId = navigator.geolocation.watchPosition(
        pos => {
          lastPos = [pos.coords.latitude, pos.coords.longitude];
          setGpsStatus(`GPS ready: ${lastPos[0].toFixed(5)}, ${lastPos[1].toFixed(5)}`, 'ok');
        },
        err => {
          setGpsStatus('GPS error: ' + err.message);
        },
        {enableHighAccuracy:true, maximumAge:10000, timeout:12000}
      );
    }

    gpsBtn.addEventListener('click', startGps);
    reloadBtn.addEventListener('click', () => {
      xcframe.src = 'https://xcfind.paraglide.us/map.html?id=16';
    });

    // Auto-start GPS on load for minimal steps
    window.addEventListener('load', () => {
      setTimeout(startGps, 400);
    });
  </script>
</body>
</html>
